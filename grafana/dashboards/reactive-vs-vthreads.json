{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "title": "Reactive vs Virtual Threads (Time Range Comparison)",
  "schemaVersion": 37,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Throughput (req/s)",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[30s]))",
          "legendFormat": "Requests/sec"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "req/s" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "type": "timeseries",
      "title": "Latency p95 (ms)",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[30s])) by (le)) * 1000",
          "legendFormat": "p95 (ms)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },

    {
      "type": "timeseries",
      "title": "Latency p99 (ms)",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[30s])) by (le)) * 1000",
          "legendFormat": "p99 (ms)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },

    {
      "type": "timeseries",
      "title": "CPU Usage (%)",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(process_cpu_usage) * 100",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },

    {
      "type": "timeseries",
      "title": "Live Threads",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_threads_live_threads)",
          "legendFormat": "Threads"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "threads" } }
    },

    {
      "type": "timeseries",
      "title": "DB Active Connections",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 35 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jdbc_connections_active)",
          "legendFormat": "Active"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "connections" } }
    }
  ]
}
